PAU_table <- fread("/Volumes/directrna/hES_update/LRAPA_output/PAU_test_hES_0.01_D7_D0_May.tsv")
PAU_DEXseq_test <- PAU_table
PAU_DEXseq_test$sig <- rgb(0.5, 0.5, 0.5, 0.5)
PAU_DEXseq_test[gene_id%in%(PAU_DEXseq_sig$gene_id)&log2fold_D7_D0>0]$sig <- "red"
PAU_DEXseq_test$delta <- (PAU_DEXseq_test$D7-PAU_DEXseq_test$D0)
PAU_DEXseq_sig <- PAU_DEXseq_test[abs(log2fold_D7_D0)>log2(1.5)&padj<0.05]
PAU_DEXseq_test[gene_id%in%(PAU_DEXseq_sig$gene_id)&log2fold_D7_D0>0]$sig <- "red"
PAU_DEXseq_test[gene_id%in%(PAU_DEXseq_sig$gene_id)&log2fold_D7_D0<0]$sig <- "blue"
plot(PAU_DEXseq_test$D0,PAU_DEXseq_test$D7,col=PAU_DEXseq_test$sig, cex=0.5, pch=16)
abline(a = 0, b = 1, lty = "dashed", col = "black")
