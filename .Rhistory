overlap_summary <- function(a, b, c) {
list(
A_and_B = intersect(a, b),
A_and_C = intersect(a, c),
B_and_C = intersect(b, c),
A_and_B_and_C = Reduce(intersect, list(a, b, c))
)
}
overlap_summary(K17_DEG_gene[col=="red"]$gene,K13_DEG_gene[col=="red"]$gene,K39_DEG_gene[col=="red"]$gene)
