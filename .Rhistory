df <- data.frame(
value = c(x, y),
group = factor(rep(c("Control", "BTG2 OE"), c(length(x), length(y))))
)
# Create the violin + jitter plot with KS test
ggviolin(df, x = "group", y = "value", fill = "group",
palette = c("#E75480", "#4682B4"),
add = "jitter", add.params = list(size = 2, alpha = 0.7)) +
stat_compare_means(method = "ks.test",
label = "p.format",
label.y = max(df$value) + 0.2) +  # adjust placement
stat_summary(fun = "mean", geom = "point",
shape = 23, size = 3, fill = "white", color = "black") +
labs(
x = "Group",
y = "polyA tail length",
title = "Distribution Comparison: BTG2 OE vs Control (KS Test)"
) +
theme_classic(base_size = 14) +
theme(legend.position = "none")
ks_res <- ks.test(x, y)
# Build violin + jitter plot
ggviolin(df, x = "group", y = "value", fill = "group",
palette = c("#E75480", "#4682B4"),
add = "jitter", add.params = list(size = 2, alpha = 0.7)) +
stat_summary(fun = "mean", geom = "point",
shape = 23, size = 3, fill = "white", color = "black") +
labs(
x = "A",
y = "B",
title = "polyA tail length Distribution Comparison (KS Test)"
) +
theme_classic(base_size = 14) +
theme(legend.position = "none") +
annotate("text",
x = 1.5,
y = max(df$value) + 0.2,
label = paste0("KS test p = ", signif(ks_res$p.value, 3)),
size = 5)
ks_res <- ks.test(x, y)
# Build violin + jitter plot
ggviolin(df, x = "group", y = "value", fill = "group",
palette = c("#E75480", "#4682B4"),
add = "jitter", add.params = list(size = 2, alpha = 0.7)) +
stat_summary(fun = "mean", geom = "point",
shape = 23, size = 3, fill = "white", color = "black") +
labs(
x = "group",
y = "polyA tail length",
title = "polyA tail length Distribution Comparison (KS Test)"
) +
theme_classic(base_size = 14) +
theme(legend.position = "none") +
annotate("text",
x = 1.5,
y = max(df$value) + 0.2,
