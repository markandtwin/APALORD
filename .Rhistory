library(ggplot2)
df <- data.frame(
value = c(x, y),
group = rep(c("x", "y"), c(length(x), length(y)))
)
ggplot(df, aes(x = value, fill = group)) +
geom_density(alpha = 0.4) +
geom_rug(aes(color = group), sides = "b") +
theme_classic() +
labs(x = "Value", y = "Density", title = "Distribution Comparison (Density)") +
scale_fill_manual(values = c("#E75480", "#4682B4")) +
scale_color_manual(values = c("#E75480", "#4682B4"))
ggplot(df, aes(x = group, y = value, fill = group)) +
geom_violin(alpha = 0.4, trim = FALSE) +
geom_jitter(width = 0.1, size = 2, alpha = 0.7) +
stat_summary(fun = "mean", geom = "point", shape = 23, size = 3, fill = "white") +
theme_classic() +
labs(x = "", y = "Value", title = "Distributions of x and y") +
scale_fill_manual(values = c("#E75480", "#4682B4"))
ggplot(df, aes(x = group, y = value, fill = group)) +
geom_violin(alpha = 0.4, trim = FALSE) +
geom_jitter(width = 0.1, size = 2, alpha = 0.7) +
stat_summary(fun = "mean", geom = "point", shape = 23, size = 3, fill = "white") +
theme_classic() +
labs(x = c("Control","BTG2 OE"), y = "Value", title = "Distributions of polyA tail length") +
scale_fill_manual(values = c("#E75480", "#4682B4"))
ggplot(df, aes(x = group, y = value, fill = group)) +
geom_violin(alpha = 0.4, trim = FALSE) +
geom_jitter(width = 0.1, size = 2, alpha = 0.7) +
stat_summary(fun = "mean", geom = "point", shape = 23,
size = 3, fill = "white", color = "black") +
theme_classic() +
labs(x = "Group", y = "Value", title = "Distribution Comparison: A vs B") +
scale_fill_manual(values = c("A" = "#E75480", "B" = "#4682B4")) +
theme(
text = element_text(size = 14),
legend.position = "none"
)
